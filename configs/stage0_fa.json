{
  "_comment": "Stage-0 safety training on FA (v1 policy). Produces the shared starting checkpoint for every lineage.",
  "model": "Qwen/Qwen2.5-0.5B-Instruct",
  "family": "fa_secret",
  "data": "data/fa_secret/train.jsonl",
  "seed": 0,
  "group_size": 8,
  "budget_trajectories": 102400,
  "grpo": {
    "learning_rate": 1e-6,
    "per_device_train_batch_size": 64,
    "gradient_accumulation_steps": 8,
    "max_prompt_length": 1024,
    "max_completion_length": 512,
    "temperature": 1.0,
    "top_p": 1.0,
    "beta": 0.0,
    "max_steps": 100000,
    "logging_steps": 1,
    "save_steps": 25,
    "save_only_model": true,
    "bf16": true,
    "gradient_checkpointing": true,
    "use_vllm": true,
    "vllm_mode": "colocate",
    "vllm_gpu_memory_utilization": 0.3,
    "report_to": "none"
  }
}
